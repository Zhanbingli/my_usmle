{
  "name": "medical-ai-platform",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@ant-design/icons": "^5.0.0",
    "@tanstack/react-query": "^5.0.0",
    "antd": "^5.0.0",
    "axios": "^1.5.0",
    "clsx": "^2.0.0",
    "firebase": "^11.8.1",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.16.0",
    "recharts": "^2.8.0",
    "tailwind-merge": "^2.0.0",
    "zustand": "^4.0.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "server": "cd functions && PORT=3001 node local-dev.js",
    "server:dev": "cd functions && PORT=3001 nodemon local-dev.js",
    "dev": "concurrently \"npm run server:dev\" \"npm run start\"",
    "firebase:serve": "firebase emulators:start --only functions,hosting",
    "firebase:deploy": "./deploy-firebase.sh",
    "firebase:logs": "firebase functions:log",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "clean": "rm -rf build && rm -rf functions/node_modules && npm run install:functions",
    "install:functions": "cd functions && npm install",
    "deploy": "npm run build && firebase deploy",
    "deploy:hosting": "npm run build && firebase deploy --only hosting"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.1",
    "react-scripts": "^5.0.1",
    "typescript": "^5.0.0"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
