# Medical AI Platform - 环境变量配置示例
# 复制此文件为 .env.local (本地开发) 或配置到Firebase Functions

# ==============================================
# 部署环境
# ==============================================
NODE_ENV=development

# ==============================================
# Gemini AI API 配置 (Google AI Studio)
# ==============================================
# 获取API密钥: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ==============================================
# PubMed API 配置
# ==============================================
# PubMed的NCBI Entrez API是免费的，不需要API密钥
# 但建议注册NCBI账户获取API密钥以避免限制
# 注册地址: https://www.ncbi.nlm.nih.gov/account/
PUBMED_API_KEY=your_ncbi_api_key_here

# ==============================================
# Firebase配置 (自动从Firebase项目获取)
# ==============================================
# 以下配置在Firebase Functions中会自动设置
# 本地开发时可以手动配置
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_REGION=us-central1

# ==============================================
# 本地开发配置
# ==============================================
PORT=3001
REACT_APP_API_BASE_URL=http://localhost:3001/api

# ==============================================
# API配置
# ==============================================
# 生产环境API地址 (部署到Firebase后自动生成)
# REACT_APP_API_BASE_URL=https://your-region-your-project.cloudfunctions.net/api

# ==============================================
# 安全配置
# ==============================================
JWT_SECRET=your_jwt_secret_here_make_it_very_secure_and_long
# 允许的前端源（逗号分隔）
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# ==============================================
# 日志配置
# ==============================================
LOG_LEVEL=info

# ==============================================
# Firebase Functions 部署说明
# ==============================================
# 1. 本地开发: 将此文件复制为 .env.local
# 2. Firebase Functions部署: 使用以下命令设置环境变量
#    firebase functions:config:set gemini.api_key="your_key"
#    firebase functions:config:set pubmed.api_key="your_key"
# 3. 或者使用 .env 文件 (Firebase CLI v11.14+) 
